# UNIOT Server Configuration

# === Network ===
LOCAL_IP=127.0.0.1
PORT=3001

# === Database Selection ===
# Options: 'mysql' (default, auto-initialize via Docker)
#          'sqlite' (local file-based, no Docker needed)
DB_TYPE=mysql

# === MySQL Configuration ===
# These variables are used by:
# 1. Docker Compose (to start MySQL container)
# 2. Node.js app (to connect to database)
# 3. generate-env.js script (to auto-initialize .env)

# MySQL Server Host (change to 'mysql' when using docker-compose)
DB_HOST=localhost

# MySQL Root Password (used for Docker initialization)
DB_ROOT_PASSWORD=root123

# MySQL Application Database Name
DB_NAME=uniot_db

# MySQL Application User
DB_USER=uniot_user

# MySQL Application User Password
DB_PASSWORD=uniot_pass

# MySQL Port (default: 3306)
# DB_PORT=3306  # Uncomment to override
